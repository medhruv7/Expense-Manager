# Copy to .env and fill in. Never commit .env.

# --- Server
EM_PORT=8642
# Shared secret for the SMS webhook and for opening the dashboard from other devices.
# Leave empty to auto-generate one in ~/.expense-manager/token
EM_TOKEN=
# Where the SQLite DB lives (kept out of OneDrive on purpose)
# EM_DATA_DIR=~/.expense-manager
# Your name as banks print it (comma-separated); payments to/from it count as self-transfers
EM_SELF_NAMES=
# Approx INR rates for foreign-currency card alerts, e.g. FX_RATES=USD=88,EUR=103
# FX_RATES=
# Tailscale logins allowed into the dashboard without the token via `tailscale serve`
# (default: the login that owns this Mac's Tailscale node)
# EM_TAILSCALE_USERS=you@github

# --- Gmail (IMAP + App Password: https://myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_POLL_MINUTES=15
GMAIL_BACKFILL_DAYS=90
# Substrings of the From: address to fetch
GMAIL_SENDER_FILTERS=hdfcbank,axisbank,axis.bank,icicibank,icici.bank,sbicard

# --- Optional LLM fallback (any OpenAI-compatible API)
LLM_ENABLED=false
# Local & private (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama
# Or OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
